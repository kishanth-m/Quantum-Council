# ─────────────────────────────────────────────────────────────────────────────
# QUANTUM COUNCIL — Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# NEVER commit real .env files with secrets to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Quantum Council
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production

# ─── Server (Loopback binding only) ───────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a random 64-character hex key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Local-First Storage Directory ────────────────────────────────────────────
# Optional: Override the per-user OS data directory location.
# Default on Windows: %LOCALAPPDATA%\QuantumCouncil
# Default on Linux:   ~/.local/share/quantum_council
# Default on macOS:   ~/Library/Application Support/QuantumCouncil
# QUANTUM_COUNCIL_DATA_DIR=

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite database path. Defaults to per-user isolated data directory.
DATABASE_URL=sqlite+aiosqlite:///./quantum_council.db

# ─── Ollama (Local AI Engine) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# ─── Privacy Mode ─────────────────────────────────────────────────────────────
# "local_only" = Strictly local Ollama execution; external calls are blocked.
# "hybrid"     = Local execution with optional user-approved cloud providers.
DEFAULT_PRIVACY_MODE=local_only

# ─── Document Storage (Knowledge Vault) ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Local Vector Index (ChromaDB) ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Rate Limiting & Networking ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Cloud Providers (Optional — for Hybrid Mode only) ────────────────────────
# Leave blank to run 100% locally. Provider keys can also be saved securely
# from the application Settings UI (encrypted via Windows DPAPI).
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

